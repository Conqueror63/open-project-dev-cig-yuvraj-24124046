{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "backend/server/index.js", "use": "@vercel/node" },
    { "src": "frontend/client/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "backend/server/index.js" },
    { "source": "/(.*)", "destination": "frontend/client/$1" }
  ]
}
